# Create a small test file and preprocess it
$testDir = "C:\Development\rustdesk-tbg-assets\bindgen-test"
New-Item -Path $testDir -ItemType Directory -Force | Out-Null
@"
#include <vpx/vpx_encoder.h>
"@ | Set-Content -Path "$testDir\test.c"

# Run clang preprocessor with the same include path bindgen would use
& "C:\Program Files\LLVM\bin\clang.exe" -E -I"C:\Development\vcpkg\installed\x64-windows-static\include" "$testDir\test.c" -o "$testDir\test.i" 2>&1 | Select-Object -First 5

# Look for vpx_codec_enc_cfg in preprocessed output
if (Test-Path "$testDir\test.i") {
    Get-Content "$testDir\test.i" | Select-String "vpx_codec_enc_cfg" -Context 0,2 | Select-Object -First 15
} else {
    Write-Host "Preprocessing failed"
}